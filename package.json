{
	"name": "powerconnect",
	"version": "1.15.24",
	"description": "Obsidian plugin: sync your vault to your own Dropbox, OneDrive, or Google Drive with optional end-to-end encryption",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild tests/tests.ts --bundle --format=cjs --outfile=tests.cjs && node tests.cjs",
		"deploy": "npm run build && node deploy.mjs"
	},
	"devDependencies": {
		"@types/node": "20.19.43",
		"esbuild": "0.21.5",
		"obsidian": "1.13.1",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	}
}
