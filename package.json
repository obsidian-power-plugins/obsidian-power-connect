{
	"name": "powerconnect",
	"version": "1.15.17",
	"description": "Obsidian plugin: sync your vault to your own Dropbox, OneDrive, or Google Drive with optional end-to-end encryption",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild tests/tests.ts --bundle --format=cjs --outfile=tests.cjs && node tests.cjs",
		"deploy": "npm run build && node deploy.mjs"
	},
	"devDependencies": {
		"@types/node": "^20.14.0",
		"esbuild": "^0.21.5",
		"obsidian": "latest",
		"tslib": "^2.6.3",
		"typescript": "^5.5.3"
	}
}
